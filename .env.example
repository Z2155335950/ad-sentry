# 复制为 .env 后按需填写。只列键名，密钥不提交仓库。

# ---- LLM (Claude) ----
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# ---- 飞书 ----
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=

# ---- Google Cloud Vision（反向图搜 + logo 检测）----
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=

# ---- ACRCloud（BGM 指纹）----
ACRCLOUD_HOST=
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=

# ---- AWS Rekognition（公众人物）----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# ---- 应用配置 ----
APP_HMAC_SECRET=dev-only-change-me
DEMO_MODE=false
DATABASE_URL=sqlite:///./data/adsentry.db
DATA_DIR=./data
FIXTURES_DIR=./fixtures
MAX_UPLOAD_MB=200
BUDGET_PER_ASSET_USD=0.25
REVIEW_TOKEN_TTL_HOURS=24

# ---- 外部工具超时（秒）----
TIMEOUT_IMAGE_SEARCH=8
TIMEOUT_MUSIC=10
TIMEOUT_CELEBRITY=8
TIMEOUT_LLM=30

# ---- 抽取层（Phase 1）----
EXTRACT_ENABLED=true
FFMPEG_BIN=
FFPROBE_BIN=
OCR_ENGINE=auto            # auto|paddle|rapidocr|none
OCR_LANG=ch
ASR_ENABLED=true
ASR_MODEL_SIZE=small
ASR_COMPUTE_TYPE=int8
ASR_MODEL_DIR=./data/models
HF_ENDPOINT=https://hf-mirror.com
SCENE_THRESHOLD=27
SCENE_MIN_LEN=15
MAX_FRAMES=12

# ---- 可选服务 ----
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
HIVE_API_KEY=
WHATFONTIS_API_KEY=
NGROK_AUTHTOKEN=
