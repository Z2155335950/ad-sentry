# 复制为 .env 后按需填写。只列键名，密钥不提交仓库。

# ---- LLM (Claude) ----
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# ---- 飞书 ----
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=
FEISHU_MODE=live            # live|mock（mock 写 data/feishu_outbox.jsonl，离线验收用）
FEISHU_DOMAIN=https://open.feishu.cn
FEISHU_LONG_CONNECTION=true # 长连接（WebSocket）；false 时走公网回调 /api/feishu/event
PUBLIC_BASE_URL=http://127.0.0.1:8000  # 卡片里复核链接的前缀，长连接模式必须配

# ---- Google Cloud Vision（反向图搜 + logo 检测）----
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
# 与 service account 二选一；有 API key 时优先用它
GOOGLE_VISION_API_KEY=

# ---- ACRCloud（BGM 指纹）----
ACRCLOUD_HOST=
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=

# ---- AWS Rekognition（公众人物）----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# ---- 应用配置 ----
APP_HMAC_SECRET=dev-only-change-me
DEMO_MODE=false
DATABASE_URL=sqlite:///./data/adsentry.db
DATA_DIR=./data
FIXTURES_DIR=./fixtures
MAX_UPLOAD_MB=200
BUDGET_PER_ASSET_USD=0.25
REVIEW_TOKEN_TTL_HOURS=24
ASSET_TTL_HOURS=24           # 素材（含抽取产物）保留时长
CLEANUP_INTERVAL_SECONDS=3600
WORKER_IN_APP=true           # docker-compose 拆 worker 时设为 false

# ---- 外部工具超时（秒）----
TIMEOUT_IMAGE_SEARCH=8
TIMEOUT_MUSIC=10
TIMEOUT_CELEBRITY=8
TIMEOUT_LLM=30

# ---- 抽取层（Phase 1）----
EXTRACT_ENABLED=true
FFMPEG_BIN=
FFPROBE_BIN=
OCR_ENGINE=auto            # auto|paddle|rapidocr|none
OCR_LANG=ch
ASR_ENABLED=true
ASR_MODEL_SIZE=small
ASR_COMPUTE_TYPE=int8
ASR_MODEL_DIR=./data/models
HF_ENDPOINT=https://hf-mirror.com
SCENE_THRESHOLD=27
SCENE_MIN_LEN=15
MAX_FRAMES=12

# ---- 工具层（Phase 2）----
TOOLS_ENABLED=true
TOOLS_MODE=mock            # mock|auto|live|off（auto：凭证齐全走 live，否则 mock）
TOOL_IMAGE_FRAMES=6        # 单素材最多送图搜的帧数（上限仍受 MAX_FRAMES=12 约束）
TOOL_CELEBRITY_FRAMES=3
TOOL_MUSIC_WINDOWS=3
MUSIC_WINDOW_SECONDS=10
CELEBRITY_MIN_CONFIDENCE=0.80

# ---- 词表与政策 RAG（Phase 3）----
WATCHLISTS_DIR=./data/watchlists
TOOL_LOGO_FRAMES=3
LOGO_CLIP_TOP_K=5
LOGO_CLIP_MIN_SCORE=0.80
TRADEMARK_FUZZY_MIN_LEN=6
POLICY_TOP_K=3
POLICY_MIN_SCORE=8.0

# ---- 授权台账（Phase 4）----
LEDGER_LLM_ENABLED=false   # 开启后用 LLM 补空字段；未装 anthropic 时自动跳过
LEDGER_LLM_MODEL=claude-opus-5-5

# ---- 可选服务 ----
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
HIVE_API_KEY=
WHATFONTIS_API_KEY=
NGROK_AUTHTOKEN=
